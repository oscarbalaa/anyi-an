DirectoryIndex index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Cabecera Authorization para los tokens
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API -> Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # Archivos reales (JS, CSS, imágenes)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Cualquier otra ruta es una pantalla de React
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # React y los archivos estáticos (la API pone las suyas en Laravel: CabecerasSeguridad)
    <FilesMatch "\.(html|js|css|svg|png|jpe?g|webp|avif|ico|woff2?|txt|json|webmanifest)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    </FilesMatch>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
        # Solo recursos propios; el captcha es una imagen data: y las descargas usan blob:
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>
