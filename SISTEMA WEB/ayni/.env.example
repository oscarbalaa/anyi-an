# Configuración local de AYNI (la crea el panel en la opción 1).
# Las claves son solo para la base de datos local, que no se expone fuera de la PC.

AYNI_APP_KEY=
# Solo para las pruebas E2E locales (salta el captcha). El panel lo genera.
AYNI_SECRETO_E2E=

AYNI_BD_NOMBRE=ayni
AYNI_BD_USUARIO=ayni
AYNI_BD_CLAVE=AyniLocal2026
AYNI_BD_ROOT_CLAVE=AyniRoot2026

AYNI_PUERTO_WEB=5173
AYNI_PUERTO_PMA=8080
AYNI_PUERTO_CORREO=8025
AYNI_PUERTO_BD=3307
