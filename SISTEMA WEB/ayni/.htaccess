# Raíz del proyecto (local y hosting).
# Solo backend/public es visible desde el navegador; el resto del proyecto
# (código, .env, 1. INICIO, docs) solo se descarga por FTP.

Options -Indexes
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On

    # En el hosting, siempre por HTTPS (en local no hay certificado)
    RewriteCond %{HTTP_HOST} ^aplicacionenlanube\.cetivirgendelapuerta\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteRule ^backend/public/ - [L]

    # Prohibido (403): archivos ocultos (.env, .git, .htaccess), vendor/, storage/
    # y cualquier archivo o carpeta real del proyecto fuera de backend/public
    RewriteRule (^|/)\. - [F]
    RewriteRule ^(vendor|storage)(/|$) - [F]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^. - [F]

    # Lo demás (React y /api) lo atiende backend/public
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
